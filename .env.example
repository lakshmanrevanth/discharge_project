# Environment template — copy to .env and fill values. Never commit .env.
#
#   cp .env.example .env
#   # edit AWS keys, then:
#   ./scripts/start.sh
#   ./scripts/stop.sh

# A2A shared secret (header: X-Agent-Auth-Token)
AGENT_AUTH_TOKEN=change-me-local-dev-token

# Bind address for servers (start.sh defaults to 0.0.0.0 if unset in the shell).
# Use 127.0.0.1 for local-only; use 0.0.0.0 for NuvePro / remote lab access.
BIND_HOST=127.0.0.1

# Local service URLs (same machine — keep 127.0.0.1 even when BIND_HOST=0.0.0.0)
EHR_BASE_URL=http://127.0.0.1:8050
MCP_PRIMARY_URL=http://127.0.0.1:8200/clinicaltools
MCP_SECONDARY_URL=http://127.0.0.1:8201/analyticstools
PUSH_WEBHOOK_URL=http://127.0.0.1:8083/push

# AWS Bedrock (required for Process patient / Extract / Normalize / Summary / RAG)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=us-east-1
BEDROCK_PRIMARY_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_FALLBACK_MODEL_ID=cohere.command-r-plus-v1:0
BEDROCK_EMBEDDING_MODEL_ID=cohere.embed-english-v3
# Structured extraction needs headroom; 500 often truncates meds/tables.
BEDROCK_MAX_TOKENS=4096

# Optional Cohere direct API (only if not using Bedrock Command R+)
COHERE_API_KEY=

# OCR (optional — Harvester falls back to a text notice when false)
TESSERACT_ENABLED=false

# LangFuse observability (optional)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# HOST is read before BASE_URL and decides where trace links point.
# Self-hosted: http://localhost:3000 · Langfuse Cloud: https://cloud.langfuse.com
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_BASE_URL=http://localhost:3000

# Optional local / lab
OLLAMA_HOST=http://127.0.0.1:11434
